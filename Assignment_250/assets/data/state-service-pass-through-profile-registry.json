      "profile_id": "STATE-SVC-STUDENT-IDENTITY-V1",
      "profile_version": "1.0.0",
      "profile_revision": 1,
      "label": "Student Identity Service",
      "capability": "Student identity lookup / match / create / pass-through",
      "direction": "Bidirectional Request / Response",
      "organization_eligibility": [
        "LEA / District",
        "School"
      ],
      "transaction_pattern": "Request / Response",
      "credential_reference_required": true,
      "idempotency": {
        "required": true,
        "key_basis": "tenant + organization + operation + source-record token",
        "duplicate_behavior": "Return prior governed result when the exact idempotency key is replayed."
      },
      "retry_policy": {
        "max_attempts": 4,
        "backoff": "Exponential with jitter",
        "retryable_errors": [
          "TEMPORARY_UNAVAILABLE",
          "RATE_LIMIT",
          "TIMEOUT"
        ],
        "non_retryable_errors": [
          "AUTHORIZATION",
          "VALIDATION",
          "AMBIGUOUS_MATCH",
          "PERMANENT_REJECTION"
        ]
      },
      "acknowledgement": {
        "mode": "Synchronous result + correlation identifier",
        "required": true
      },
      "error_handling": "Retry only retryable technical failures. Ambiguous/validation results require governed review; CREATE never auto-runs after ambiguous MATCH.",
      "evidence_policy": "Persist correlation ID, idempotency key hash, organization binding revision, attempt count, response category, evidence ID and timestamps; do not persist raw protected identity payload in packaged evidence.",
      "profile_contract_hash": "71a320c960795c5adb57b01e9801e60794aa38dceb7293539016e6a3e417b2db"
    },
